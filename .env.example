# For docker run --env-file .env with an existing TimescaleDB database.
# Copy this file to .env and replace every placeholder. Do not commit .env.
ConnectionStrings__Database=Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<password>;SSL Mode=VerifyFull

# ConnectionStrings__tokenscope takes precedence when nonblank.
# docker compose uses the bundled database; these ports can be overridden:
# TOKENSCOPE_PORT=5299
# TOKENSCOPE_DB_PORT=55432
